# HMI Certificate Mobile App — Environment Configuration
#
# Copy this file to .env and set the values for your environment.
# NEVER commit the .env file — it is listed in .gitignore.
#
# All variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle.
# Do NOT put secrets, API keys, or database credentials here.

# The origin of the Hono API server. The client will append /api to all requests.
#
# Android Emulator: use http://10.0.2.2:3000 (loopback alias for your PC's localhost)
# Physical Android device: use your PC's LAN IP, e.g. http://192.168.1.10:3000
# iOS Simulator: use http://localhost:3000
# Deployed server: use the production HTTPS origin, e.g. https://api.yourdomain.com
#
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
