# ==============================================================================
# HMI Certificate System - AWS Production / Cloud Environment Configuration
# ==============================================================================
# All values shown below are placeholders. Never commit actual secrets or credentials.

NODE_ENV=production
PORT=3000

# PostgreSQL RDS Connection (Amazon RDS in ap-south-1)
# Restrict port 5432 to hmi-cert-api-sg; enforce SSL mode
DATABASE_URL=postgresql://hmi_admin:YOUR_SECURE_PASSWORD@hmi-cert-postgres.cdmi866iew37.ap-south-1.rds.amazonaws.com:5432/hmi_certificates?sslmode=require

# AWS Region & S3 Storage
# EC2 instance role provides credentials automatically. Do not set AWS_ACCESS_KEY_ID in production.
AWS_REGION=ap-south-1
CERTIFICATE_S3_BUCKET=hmi-cert-pdfs-212641463846-ap-south-1
PARTICIPANT_IMPORT_S3_BUCKET=hmi-cert-pdfs-212641463846-ap-south-1

# Amazon Cognito Identity Configuration
# Populated from CloudFormation stack 'hmi-cert-cognito' outputs
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=ap-south-1

# Web Application & Verification URLs
AUTH_WEB_ORIGIN=https://your-domain.example.com
AUTH_APP_BASE_URL=https://your-domain.example.com
CERTIFICATE_PUBLIC_VERIFY_BASE_URL=https://your-domain.example.com/verify

# Session and Auth Token TTLs (seconds)
AUTH_SESSION_TTL_SECONDS=604800
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# CloudWatch Logging
CLOUDWATCH_LOG_GROUP=/aws/hmi-cert/api
